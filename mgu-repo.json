{
  "schema": 1,
  "components": [
    {
      "id": "jap_ridetube",
      "kind": "app",
      "path": "apps/jap_ridetube",
      "manifest": "app.json",
      "mguHmi": ["ID7"],
      "requires": {
        "jap-ridetube-d": "0.6.0",
        "mgu-render": "0.6.11",
        "mgu-inputgate": "1.0.0"
      },
      "build": {
        "python": "kit/tools/build.py",
        "args": ["{id}"],
        "sdk": "oap-sdk",
        "output": "dist/{id}@{version}.tgz"
      }
    }
  ]
}
